generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdentityProvider {
  DISCORD
}

enum WalletStatus {
  ACTIVE
  REVOKED
}

enum ReconciliationStatus {
  PENDING
  RESOLVED
  REJECTED
}

model Collector {
  id           String                 @id @default(uuid()) @db.Uuid
  slug         String                 @unique
  displayName  String?
  bio          String?
  avatar       String?
  isPublic     Boolean                @default(false)
  showWallets  Boolean                @default(false)
  showDiscord  Boolean                @default(false)
  featuredTokenIds Int[]              @default([])
  featuredAchievementIds String[] @default([])
  selectedTitleId String?
  featuredSetIds String[] @default([])
  collectionVisibility CollectionVisibility @default(FULL)
  galleries CollectorGallery[]
  displayPreferences SquigDisplayPreference[]
  cosmeticPreferences CollectorCosmeticPreference[]
  cosmeticEntitlements CosmeticEntitlement[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  identities   ExternalIdentity[]
  wallets      CollectorWallet[]
  activities   CollectorActivity[]
  discoveries  SquigDiscovery[]
  progress     CollectorProgress?
  achievements CollectorAchievement[]
  sets         CollectorSetProgress[]
  quests       QuestProgress[]
  sessions     AuthSession[]
  refreshRequest CollectorRefreshRequest?
  attributions HistoricalIdentityAttribution[]
  holdingPeriods CollectorOwnershipPeriod[]
}

model ExternalIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  collectorId     String           @db.Uuid
  collector       Collector        @relation(fields: [collectorId], references: [id])
  provider        IdentityProvider
  externalId      String
  username        String?
  displayName     String?
  metadata        Json?
  linkedAt        DateTime         @default(now())
  authenticatedAt DateTime?

  @@unique([provider, externalId])
  @@index([collectorId])
}

model CollectorWallet {
  id              String       @id @default(uuid()) @db.Uuid
  collectorId     String       @db.Uuid
  collector       Collector    @relation(fields: [collectorId], references: [id])
  chainId         Int
  walletAddress   String       @db.VarChar(42)
  checksumAddress String?      @db.VarChar(42)
  source          String
  verifiedAt      DateTime
  firstSeenAt     DateTime     @default(now())
  lastSeenAt      DateTime     @default(now())
  revokedAt       DateTime?
  status          WalletStatus @default(ACTIVE)
  isPrimary       Boolean      @default(false)

  @@unique([chainId, walletAddress])
  @@index([collectorId, status])
}

// Legacy evidence is separate from credentials. No ownership or login grants.
model WalletLinkEvidence {
  id              String    @id @default(uuid()) @db.Uuid
  sourceKey       String    @unique
  discordId       String
  guildId         String
  chainId         Int       @default(1)
  walletAddress   String
  legacyVerified  Boolean
  sourceCreatedAt DateTime?
  sourceUpdatedAt DateTime?
  observedAt      DateTime  @default(now())

  @@index([walletAddress, discordId])
}

model IdentityReconciliation {
  id         String               @id @default(uuid()) @db.Uuid
  dedupeKey  String               @unique
  status     ReconciliationStatus @default(PENDING)
  reason     String
  evidence   Json
  resolution Json?
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?
  decisions ReconciliationDecision[]
  @@index([status, createdAt])
}

model Squig {
  id                 String               @id @default(uuid()) @db.Uuid
  tokenId            Int
  contractAddress    String
  chainId            Int                  @default(1)
  imageUrl           String?
  name               String?
  metadata           Json?
  uglyPoints         Decimal?             @db.Decimal(20, 4)
  mawRank            Int?
  rarityTier         String?
  legendary          Boolean?
  og                 Boolean?
  metadataUpdatedAt  DateTime?
  metadataSourceHash String?
  traits             SquigTrait[]
  ownerships         SquigOwnership[]
  discoveries        SquigDiscovery[]
  activities         CollectorActivity[]
  passport           SquigPassportEvent[]
  progress           SquigProgress?
  achievements       SquigAchievement[]
  transfers NftTransfer[]
  walletPeriods WalletOwnershipPeriod[]
  collectorPeriods CollectorOwnershipPeriod[]
  provenance SquigProvenance?
  galleryItems CollectorGalleryItem[]
  customs SquigCustom[]
  editionRelations SquigEditionRelation[]
  displayPreferences SquigDisplayPreference[]

  @@unique([chainId, contractAddress, tokenId])
  @@index([uglyPoints, tokenId])
  @@index([mawRank, tokenId])
  @@index([rarityTier, og, legendary])
}

enum CollectionVisibility {
  FULL
  FEATURED_ONLY
  HIDDEN
}

enum GalleryVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum GalleryMode {
  CURRENT_COLLECTION
  DISCOVERED_HISTORY
}

enum GalleryLayout {
  GRID
  EXHIBITION
  COMPACT
}

model CollectorGallery {
  id String @id @default(uuid()) @db.Uuid
  collectorId String @db.Uuid
  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  slug String
  name String
  description String @default("")
  visibility GalleryVisibility @default(PRIVATE)
  mode GalleryMode @default(CURRENT_COLLECTION)
  layout GalleryLayout @default(GRID)
  coverTokenId Int?
  featured Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items CollectorGalleryItem[]
  @@unique([collectorId, slug])
  @@index([collectorId, visibility, featured])
}

model CollectorGalleryItem {
  galleryId String @db.Uuid
  gallery CollectorGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  squigId String @db.Uuid
  squig Squig @relation(fields: [squigId], references: [id])
  sortOrder Int
  caption String @default("")
  section String @default("")
  addedAt DateTime @default(now())
  customId String? @db.Uuid
  custom SquigCustom? @relation(fields: [customId], references: [id])
  @@id([galleryId, squigId])
  @@index([galleryId, sortOrder])
}

model ShareRenderMetric {
  id String @id @default(uuid()) @db.Uuid
  kind String
  status String
  cacheHit Boolean @default(false)
  artworkFailures Int @default(0)
  durationMs Int
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model SquigTrait {
  id        String @id @default(uuid()) @db.Uuid
  squigId   String @db.Uuid
  squig     Squig  @relation(fields: [squigId], references: [id])
  traitType String
  value     String

  @@unique([squigId, traitType])
  @@index([traitType, value])
}

model SquigOwnership {
  id              String    @id @default(uuid()) @db.Uuid
  squigId         String    @db.Uuid
  squig           Squig     @relation(fields: [squigId], references: [id])
  walletAddress   String
  fromWallet      String?
  sourceKey       String    @unique
  source          String
  blockNumber     BigInt
  blockHash       String
  transactionHash String?
  logIndex        Int?
  acquiredAt      DateTime?
  observedAt      DateTime  @default(now())
  isCurrent       Boolean   @default(false)

  @@index([squigId, blockNumber])
  @@index([walletAddress, isCurrent])
}

model SquigDiscovery {
  id           String    @id @default(uuid()) @db.Uuid
  collectorId  String    @db.Uuid
  collector    Collector @relation(fields: [collectorId], references: [id])
  squigId      String    @db.Uuid
  squig        Squig     @relation(fields: [squigId], references: [id])
  discoveredAt DateTime
  sourceKey    String
  everOwned    Boolean   @default(false)
  attributionStatus String @default("OBSERVED")
  firstOwnershipPeriod String?

  @@unique([collectorId, squigId])
  @@index([collectorId, everOwned, discoveredAt])
}

model CollectorActivity {
  id             String               @id @default(uuid()) @db.Uuid
  eventKey       String               @unique
  collectorId    String?              @db.Uuid
  collector      Collector?           @relation(fields: [collectorId], references: [id])
  squigId        String?              @db.Uuid
  squig          Squig?               @relation(fields: [squigId], references: [id])
  sourceSystem   String
  sourceType     String
  sourceId       String
  subjectKey     String
  eventType      String
  eventAt        DateTime
  metadata       Json
  payloadHash    String
  importedAt     DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  passportEvents SquigPassportEvent[]
  discordId String?
  walletAddress String?
  attributionStatus String @default("RESOLVED")
  category String @default("OTHER")
  visibility String @default("PRIVATE")
  importance String @default("STANDARD")
  recordStatus String @default("ACTIVE")
  amount Decimal? @db.Decimal(30, 8)
  currency String?
  direction String?
  sourceCreatedAt DateTime?
  sourceUpdatedAt DateTime?
  correctedAt DateTime?
  corrections ActivityCorrection[]

  @@unique([sourceSystem, sourceType, sourceId, subjectKey, eventType])
  @@index([collectorId, eventAt])
  @@index([collectorId, id])
  @@index([squigId, id])
  @@index([squigId, eventAt, id])
  @@index([collectorId, category, eventAt, id])
  @@index([sourceSystem, sourceType, sourceId])
  @@index([sourceSystem, eventAt])
  @@index([eventType, eventAt])
  @@index([attributionStatus, eventAt])
  @@index([discordId])
  @@index([walletAddress])
}

model ActivityCorrection {
  id String @id @default(uuid()) @db.Uuid
  activityId String @db.Uuid
  activity CollectorActivity @relation(fields: [activityId], references: [id])
  reason String
  before Json
  afterHash String
  createdAt DateTime @default(now())
  @@index([activityId, createdAt])
}

model IntegrationSource {
  id String @id
  state String @default("UNVALIDATED")
  schemaFingerprint String?
  schemaValid Boolean?
  cursor Json?
  reconcileCursor Json?
  firstAvailableAt DateTime?
  lastAvailableAt DateTime?
  importedThrough DateTime?
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  backfillFinishedAt DateTime?
  warning String?
  updatedAt DateTime @updatedAt
}

model ImportRejection {
  id String @id @default(uuid()) @db.Uuid
  source String
  sourceRecordId String
  code String
  runId String @db.Uuid
  attempts Int @default(1)
  resolvedAt DateTime?
  updatedAt DateTime @updatedAt
  @@unique([source, sourceRecordId])
  @@index([source, resolvedAt])
}

model ActivityAttributionJob {
  walletAddress String @id
  cursor String?
  generation Int @default(1)
  queuedAt DateTime @default(now())
}

model ProgressionRuleset {
  id String @id
  fingerprint String
  status String @default("ACTIVE")
  configuration Json
  createdAt DateTime @default(now())
}

// Subject IDs reference Collector/Squig by subjectType. Ledger evidence survives source rebuilds.
model XpLedgerEntry {
  id String @id
  ruleset String
  subjectType String
  subjectId String @db.Uuid
  ruleId String
  grantKey String
  sourceActivityId String?
  xp Int
  earnedAt DateTime
  evidence Json
  createdAt DateTime @default(now())
  revokedAt DateTime?
  @@index([ruleset, subjectType, subjectId, revokedAt])
  @@index([sourceActivityId])
  @@index([ruleId])
}

model ProgressionAudit {
  id String @id @default(uuid()) @db.Uuid
  ruleset String
  subjectType String
  subjectId String @db.Uuid
  kind String
  reference String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([subjectType, subjectId, createdAt])
  @@index([ruleset, kind])
}

model ProgressionJob {
  subjectType String
  subjectId String @db.Uuid
  generation Int @default(1)
  queuedAt DateTime @default(now())
  attempts Int @default(0)
  errorCode String?
  @@id([subjectType, subjectId])
  @@index([queuedAt])
}

model ProgressionMilestone {
  ruleset String
  subjectType String
  subjectId String @db.Uuid
  level Int
  reachedAt DateTime
  @@id([ruleset, subjectType, subjectId, level])
}

model ProgressionReplay {
  id String @id
  stage String @default("COLLECTOR")
  cursor String?
  completedAt DateTime?
  updatedAt DateTime @updatedAt
}

model SquigPassportEvent {
  id           String             @id @default(uuid()) @db.Uuid
  eventKey     String             @unique
  squigId      String             @db.Uuid
  squig        Squig              @relation(fields: [squigId], references: [id])
  activityId   String?            @db.Uuid
  activity     CollectorActivity? @relation(fields: [activityId], references: [id])
  eventType    String
  eventAt      DateTime
  sourceSystem String
  sourceId     String
  metadata     Json

  @@index([squigId, eventAt])
}

model CollectorProgress {
  collectorId  String    @id @db.Uuid
  collector    Collector @relation(fields: [collectorId], references: [id])
  xp           BigInt    @default(0)
  level        Int       @default(1)
  rulesVersion String
  calculatedAt DateTime  @default(now())
}

model SquigProgress {
  squigId      String   @id @db.Uuid
  squig        Squig    @relation(fields: [squigId], references: [id])
  xp           BigInt   @default(0)
  level        Int      @default(1)
  rulesVersion String
  calculatedAt DateTime @default(now())
}

model AchievementDefinition {
  id          String                 @id
  name        String
  description String
  rules       Json
  version     Int                    @default(1)
  ruleset String @default("legacy")
  subjectType String @default("COLLECTOR")
  category String @default("OTHER")
  tier String @default("Common")
  hidden Boolean @default(false)
  title String?
  sortOrder Int @default(0)
  collectors  CollectorAchievement[]
  squigs      SquigAchievement[]
  @@index([ruleset, subjectType])
}

model CollectorAchievement {
  collectorId   String                @db.Uuid
  collector     Collector             @relation(fields: [collectorId], references: [id])
  achievementId String
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id])
  awardedAt     DateTime?
  evidence      Json
  revokedAt DateTime?
  evaluatedAt DateTime @default(now())
  progress Int @default(0)
  gateSatisfied Boolean @default(false)

  @@id([collectorId, achievementId])
  @@index([achievementId, revokedAt])
}

model SquigAchievement {
  squigId       String                @db.Uuid
  squig         Squig                 @relation(fields: [squigId], references: [id])
  achievementId String
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id])
  awardedAt     DateTime?
  evidence      Json
  revokedAt DateTime?
  evaluatedAt DateTime @default(now())
  progress Int @default(0)
  gateSatisfied Boolean @default(false)

  @@id([squigId, achievementId])
  @@index([achievementId, revokedAt])
}

model CollectionSetDefinition {
  ruleset String @default("legacy")
  mode String @default("HISTORICAL_DISCOVERY")
  category String @default("OTHER")
  difficulty String @default("Medium")
  hidden Boolean @default(false)
  enabled Boolean @default(true)
  sortOrder Int @default(0)
  id           String                     @id
  name         String
  description  String
  version      Int                        @default(1)
  requirements CollectionSetRequirement[]
  collectors   CollectorSetProgress[]
}

model CollectionSetRequirement {
  id            String                  @id @default(uuid()) @db.Uuid
  setId         String
  set           CollectionSetDefinition @relation(fields: [setId], references: [id])
  key           String
  criteria      Json
  requiredCount Int                     @default(1)

  @@unique([setId, key])
}

model CollectorSetProgress {
  currentlyComplete Boolean @default(false)
  firstCompletedAt DateTime?
  lastCompletedAt DateTime?
  completionCount Int @default(0)
  collectorId  String                  @db.Uuid
  collector    Collector               @relation(fields: [collectorId], references: [id])
  setId        String
  set          CollectionSetDefinition @relation(fields: [setId], references: [id])
  progress     Json
  completedAt  DateTime?
  calculatedAt DateTime                @default(now())

  @@id([collectorId, setId])
  @@index([setId, currentlyComplete])
}

model QuestDefinition {
  id          String          @id
  name        String
  description String
  criteria    Json
  version     Int             @default(1)
  startsAt    DateTime?
  endsAt      DateTime?
  progress    QuestProgress[]
}

model QuestProgress {
  collectorId  String          @db.Uuid
  collector    Collector       @relation(fields: [collectorId], references: [id])
  questId      String
  quest        QuestDefinition @relation(fields: [questId], references: [id])
  progress     Json
  completedAt  DateTime?
  calculatedAt DateTime        @default(now())

  @@id([collectorId, questId])
}

model SyncRun {
  id         String    @id @default(uuid()) @db.Uuid
  source     String
  status     String    @default("RUNNING")
  counts     Json
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  cursorStart Json?
  cursorEnd Json?
  errorCode String?
  @@index([source, startedAt])
}

model ChainCursor {
  key         String   @id
  blockNumber BigInt
  blockHash   String
  updatedAt   DateTime @updatedAt
  startBlock BigInt?
  finalizedBlock BigInt?
  lastSuccessAt DateTime?
  lastError String?
}

model ChainBlock {
  chainId Int
  number BigInt
  hash String
  timestamp DateTime
  @@id([chainId, number])
}

model NftTransfer {
  id String @id
  chainId Int
  contractAddress String
  tokenId Int
  squigId String @db.Uuid
  squig Squig @relation(fields: [squigId], references: [id])
  fromAddress String
  toAddress String
  transactionHash String
  logIndex Int
  transactionIndex Int
  blockNumber BigInt
  blockHash String
  eventAt DateTime
  indexedAt DateTime @default(now())
  finalized Boolean @default(true)
  @@unique([chainId, transactionHash, logIndex])
  @@index([squigId, blockNumber, logIndex])
  @@index([squigId, eventAt])
  @@index([fromAddress, eventAt])
  @@index([toAddress, eventAt])
  @@index([blockNumber])
  @@index([transactionHash])
}

model WalletOwnershipPeriod {
  id String @id
  squigId String @db.Uuid
  squig Squig @relation(fields: [squigId], references: [id])
  walletAddress String
  acquiredAt DateTime
  lostAt DateTime?
  acquisitionEvent String
  lossEvent String?
  @@index([squigId, acquiredAt])
  @@index([walletAddress, acquiredAt])
  @@index([squigId, lostAt])
}

model HistoricalIdentityAttribution {
  id String @id @default(uuid()) @db.Uuid
  sourceKey String @unique
  collectorId String @db.Uuid
  collector Collector @relation(fields: [collectorId], references: [id])
  chainId Int @default(1)
  walletAddress String
  source String
  status String
  confidence String
  effectiveFrom DateTime
  effectiveTo DateTime?
  evidence Json
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([walletAddress, effectiveFrom, effectiveTo])
  @@index([collectorId, status])
}

model CollectorOwnershipPeriod {
  id String @id
  squigId String @db.Uuid
  squig Squig @relation(fields: [squigId], references: [id])
  collectorId String @db.Uuid
  collector Collector @relation(fields: [collectorId], references: [id])
  acquiredAt DateTime
  lostAt DateTime?
  evidenceIds String[]
  walletAddresses String[]
  acquisitionEvent String
  lossEvent String?
  @@index([squigId, acquiredAt])
  @@index([collectorId, acquiredAt])
  @@index([collectorId, lostAt])
}

model SquigProvenance {
  squigId String @id @db.Uuid
  squig Squig @relation(fields: [squigId], references: [id])
  dirty Boolean @default(true)
  complete Boolean @default(false)
  issues Json @default("[]")
  mintAt DateTime?
  minter String?
  mintTransaction String?
  mintBlock BigInt?
  currentWallet String?
  currentSince DateTime?
  transferCount Int @default(0)
  uniqueWallets Int @default(0)
  longestHoldSeconds BigInt?
  derivedThrough BigInt?
  verifiedAt DateTime?
  ownerMatches Boolean?
  updatedAt DateTime @updatedAt
  @@index([dirty, complete])
}

model ReconciliationDecision {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  case IdentityReconciliation @relation(fields: [caseId], references: [id])
  actor String
  action String
  reason String
  before Json
  after Json
  createdAt DateTime @default(now())
  @@index([caseId, createdAt])
}

model AuthChallenge {
  id          String    @id
  kind        String
  subject     String
  message     String?
  collectorId String?   @db.Uuid
  expiresAt   DateTime
  consumedAt  DateTime?

  @@index([expiresAt])
}

model AuthSession {
  tokenHash   String    @id
  collectorId String    @db.Uuid
  collector   Collector @relation(fields: [collectorId], references: [id])
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([collectorId])
  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

// One coalesced, resumable finalized ownership scan for the entire contract.
model OwnershipRefresh {
  id String @id @default("squigs")
  status String @default("QUEUED")
  nextToken Int @default(1)
  blockNumber BigInt?
  blockHash String?
  blockTime DateTime?
  requestedAt DateTime @default(now())
  startedAt DateTime?
  completedAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  errorCode String?
  updatedAt DateTime @updatedAt
}

model CollectorRefreshRequest {
  collectorId String @id @db.Uuid
  collector Collector @relation(fields: [collectorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedAt DateTime @default(now())
}

model CollectionRuleset {
 id String @id
 fingerprint String
 configuration Json
 createdAt DateTime @default(now())
}
model CanonicalTrait {
 ruleset String
 key String
 traitType String
 value String
 tokenCount Int
 firstToken Int
 ogCount Int
 legendaryOnly Boolean
 @@id([ruleset, key])
 @@index([ruleset, traitType, value])
}
model CollectorTraitDiscovery {
 ruleset String
 collectorId String @db.Uuid
 traitKey String
 tokenId Int
 firstDiscoveredAt DateTime
 evidence String
 revokedAt DateTime?
 @@id([ruleset, collectorId, traitKey])
 @@index([collectorId, revokedAt])
}
model CollectionSnapshot {
 ruleset String
 collectorId String @db.Uuid
 discovered Int
 traits Int
 historicalSets Int
 currentSets Int
 overall Float
 discoveredTokenIds Int[]
 currentTokenIds Int[]
 traitCounts Json @default("{}")
 candidates Json
 calculatedAt DateTime @default(now())
 @@id([ruleset, collectorId])
}
model CollectionAudit {
 id String @id @default(uuid()) @db.Uuid
 ruleset String
 collectorId String @db.Uuid
 kind String
 reference String
 before Json?
 after Json?
 createdAt DateTime @default(now())
 @@index([collectorId, createdAt])
}
model CollectionMilestone {
 ruleset String
 collectorId String @db.Uuid
 key String
 reachedAt DateTime
 timeBasis String
 revokedAt DateTime?
 @@id([ruleset, collectorId, key])
}
model CollectionJob {
 collectorId String @id @db.Uuid
 generation Int @default(1)
 queuedAt DateTime @default(now())
 attempts Int @default(0)
 errorCode String?
 @@index([queuedAt])
}
model CollectionReplay {
 id String @id
 cursor String?
 completedAt DateTime?
 updatedAt DateTime @updatedAt
}

// Absent controls are disabled. Deployment never opts into historical scanning.
model WorkerControl {
 service String @id
 mode String @default("DISABLED")
 updatedBy String
 updatedAt DateTime @updatedAt
}

model WorkerHeartbeat {
 service String
 instanceId String
 state String
 mode String
 lockHeld Boolean @default(false)
 lastHeartbeat DateTime @default(now())
 lastSuccessAt DateTime?
 errorCode String?
 runId String?
 @@id([service, instanceId])
 @@index([lastHeartbeat])
}

model ProductionStage {
 stage String @id
 status String @default("PENDING")
 attempts Int @default(0)
 runId String?
 counts Json @default("{}")
 startedAt DateTime?
 completedAt DateTime?
 errorCode String?
 updatedAt DateTime @updatedAt
}

model OperationalAudit {
 id String @id @default(uuid()) @db.Uuid
 actor String
 action String
 subject String
 detail Json
 createdAt DateTime @default(now())
 @@index([createdAt])
}

enum CollectibleStatus {
 DRAFT
 VERIFIED
 RETIRED
}

// Only immutable IPFS raster assets. Approval snapshots retain prior asset hashes.
model CollectibleArtwork {
 id String @id
 uri String @unique
 sha256 String
 mime String
 width Int
 height Int
 byteLength Int
 validatedAt DateTime @default(now())
 customs SquigCustom[]
 editions SquigEdition[]
}

model SquigCustom {
 id String @id @default(uuid()) @db.Uuid
 key String @unique
 squigId String @db.Uuid
 squig Squig @relation(fields: [squigId], references: [id])
 name String
 description String @default("")
 artist String?
 issuedAt DateTime?
 status CollectibleStatus @default(DRAFT)
 source String
 sourceReference String
 artworkId String
 artwork CollectibleArtwork @relation(fields: [artworkId], references: [id])
 sortOrder Int @default(0)
 revision Int @default(1)
 verifiedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 displayPreferences SquigDisplayPreference[]
 galleryItems CollectorGalleryItem[]
 @@index([squigId, status, sortOrder])
}

