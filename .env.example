# UglyDex-owned database ONLY. Never an ecosystem database.
DATABASE_URL=postgresql://uglydex:local_password@localhost:5432/uglydex
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
# Dedicated read-only users; optional. No implicit URL fallbacks.
WALLET_LINKS_DATABASE_URL=
UGLYBOT_DATABASE_URL=
UGLYBOT_PRIZES_DATABASE_URL=
UGLYBOT_CLAIMS_DATABASE_URL=
UGLYBOT_POINTS_DATABASE_URL=
GAUNTLET_DATABASE_URL=
GAUNTLET_SURVIVAL_DATABASE_URL=
GAUNTLET_IMAGE_DATABASE_URL=
IMAGE_SUBMIT_DATABASE_URL=
# HTTPS transport takes precedence when either bridge variable is set; no silent fallback.
UGLYBOT_BRIDGE_URL=
UGLYBOT_BRIDGE_SECRET=
GAUNTLET_BRIDGE_URL=
GAUNTLET_BRIDGE_SECRET=
IMAGE_BRIDGE_URL=
IMAGE_BRIDGE_SECRET=
# Explicit guild scope for canonical UglyBot link evidence.
ECOSYSTEM_GUILD_ID=
ETH_RPC_URL=
SQUIGS_CONTRACT_ADDRESS=0x8c9a02c0585200c4c65608df6b8def543d33792a
# Blockscout reports 25342921; first-run archive RPC code-boundary validation required.
SQUIGS_START_BLOCK=
TRANSFER_BLOCK_BATCH=1000
REORG_REWIND_BLOCKS=128
RPC_CONCURRENCY=3
RPC_RETRIES=4
RPC_TIMEOUT_MS=15000
ETH_EXPLORER_URL=https://etherscan.io
# Authenticated Discord IDs allowed to use production review/provenance admin pages.
ADMIN_DISCORD_IDS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Random >=32-character values. Opaque sessions are stored hashed; no NextAuth dependency.
AUTH_SECRET=
ADMIN_DIAGNOSTICS_TOKEN=
# Optional image-root override for metadata PNG filenames. Leave blank to use
# the immutable artwork CID verified from Ethereum tokenURI metadata.
SQUIG_IMAGE_BASE_URL=
# Phase 7: worker enablement is stored in UglyDex WorkerControl, not inferred
# from these variables. Default is DISABLED; use production:worker after preflight.
# Recommended Railway service setting for bounded task shutdown:
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=90
# Phase 8: explicit deployment identity. Register the dedicated DB after migration.
APP_ENV=development
# Optional per-service pool budget; workers also reserve advisory-lock connections.
DB_POOL_MAX=8
WORKER_INTERVAL_MS=15000
# Set APP_COMMIT to the deployed revision when Railway does not supply it.
# APP_COMMIT=<git SHA>
# Staging only: match PUBLIC_BASE_URL and compare with production references.
STAGING_BASE_URL=
PRODUCTION_BASE_URL=
PRODUCTION_DATABASE_FINGERPRINT=
# Short-lived operator session intent, never leave enabled in worker services:
# OPS_CONFIRM=production:backfill
# OPS_DATABASE_FINGERPRINT=<output of npm run ops:fingerprint>
# Restore tooling requires local PostgreSQL client binaries and an empty target:
# RESTORE_DRILL_CONFIRM=RESTORE_INTO_EMPTY_DISPOSABLE_DATABASE
# RESTORE_TARGET_URL=<operator-only secret; never commit>
