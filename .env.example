# UglyDex-owned database ONLY. Never an ecosystem database.
DATABASE_URL=postgresql://uglydex:local_password@localhost:5432/uglydex
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
# Dedicated read-only users; optional. No implicit URL fallbacks.
WALLET_LINKS_DATABASE_URL=
UGLYBOT_DATABASE_URL=
UGLYBOT_PRIZES_DATABASE_URL=
UGLYBOT_CLAIMS_DATABASE_URL=
UGLYBOT_POINTS_DATABASE_URL=
GAUNTLET_DATABASE_URL=
GAUNTLET_SURVIVAL_DATABASE_URL=
GAUNTLET_IMAGE_DATABASE_URL=
IMAGE_SUBMIT_DATABASE_URL=
# Explicit guild scope for canonical UglyBot link evidence.
ECOSYSTEM_GUILD_ID=
ETH_RPC_URL=
SQUIGS_CONTRACT_ADDRESS=0x8c9a02c0585200c4c65608df6b8def543d33792a
# Blockscout reports 25342921; first-run archive RPC code-boundary validation required.
SQUIGS_START_BLOCK=
TRANSFER_BLOCK_BATCH=1000
REORG_REWIND_BLOCKS=128
RPC_CONCURRENCY=3
RPC_RETRIES=4
RPC_TIMEOUT_MS=15000
ETH_EXPLORER_URL=https://etherscan.io
# Authenticated Discord IDs allowed to use production review/provenance admin pages.
ADMIN_DISCORD_IDS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Random >=32-character values. Opaque sessions are stored hashed; no NextAuth dependency.
AUTH_SECRET=
ADMIN_DIAGNOSTICS_TOKEN=
# Optional image-root override for metadata PNG filenames. Leave blank to use
# the immutable artwork CID verified from Ethereum tokenURI metadata.
SQUIG_IMAGE_BASE_URL=
